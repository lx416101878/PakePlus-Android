{"name":"bdbabffdffda","url":"https://localhost","showName":"生肖抽取","appid":"com.bdbabffdffda.pakeplus","icon":"","iconPath":"C:\\Users\\46767\\AppData\\Roaming\\com.pakeplus.pacbao\\0tz0jqnbc5y.png","iconRound":true,"state":true,"single":true,"injectJq":true,"tauriApi":false,"devbug":false,"version":"0.0.1","preview":"Android","platform":[],"width":412,"height":915,"desc":"","jsFile":[],"filterCss":"","customJs":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>生肖抽取</title>\n<style>\n*{box-sizing:border-box;font-size:18px;font-family:system-ui}\nbody{padding:20px;margin:0;background:#f6f6f6}\n.box{background:#fff;padding:20px;border-radius:12px;max-width:600px;margin:0 auto}\n#log{white-space:pre-wrap;background:#111;color:#0f0;padding:12px;border-radius:8px;min-height:220px;margin-bottom:12px;overflow-y:auto}\ninput{width:100%;padding:10px;border:1px solid #ccc;border-radius:8px;margin-bottom:10px}\nbutton{padding:10px 16px;background:#2563eb;color:white;border:none;border-radius:8px;width:100%}\n</style>\n</head>\n<body>\n<div class=\"box\">\n<div id=\"log\"></div>\n<input id=\"inp\" placeholder=\"输入排除生肖，q退出\" autocomplete=\"off\">\n<button onclick=\"run()\">开始抽取</button>\n</div>\n<script>\nconst zodiac = [\"鼠\", \"牛\", \"虎\", \"兔\", \"龙\", \"蛇\", \"马\", \"羊\", \"猴\", \"鸡\", \"狗\", \"猪\"];\nconst logDom = document.getElementById(\"log\");\nconst inpDom = document.getElementById(\"inp\");\n\n// 安全随机洗牌（等价于Python SystemRandom）\nfunction shuffle(arr){\n    let a = [...arr];\n    for(let i=a.length-1;i>0;i--){\n        const r = new Uint32Array(1);\n        crypto.getRandomValues(r);\n        const j = r[0] % (i+1);\n        [a[i],a[j]] = [a[j],a[i]];\n    }\n    return a;\n}\n\nfunction print(s){\n    logDom.innerText += s + \"\\n\";\n    logDom.scrollTop = logDom.scrollHeight;\n}\n\nprint(\"===== 生肖抽取程序 =====\");\nprint(\"十二生肖列表：\" + zodiac.join(\"、\"));\nprint(\"输入要排除的1个生肖，输入q退出程序\\n\");\n\nfunction run(){\n    const text = inpDom.value.trim();\n    inpDom.value = \"\";\n    if(text.toLowerCase() === \"q\"){\n        print(\"程序已退出\");\n        return;\n    }\n    const pool = zodiac.filter(item=>item!==text);\n    if(pool.length ===12){\n        print(`⚠️ 警告：「${text}」不在生肖列表，使用全部12个抽取`);\n    }else{\n        print(`✅ 已排除【${text}】，剩余${pool.length}个，随机抽8个`);\n    }\n    const shuffled = shuffle(pool);\n    const res = shuffled.slice(0,8);\n    print(\"本次选出8个生肖：\" + res.join(\"、\"));\n    print(\"——————————————————————\");\n}\n// 回车触发\ninpDom.onkeydown = e=>{if(e.key===\"Enter\")run()}\n</script>\n</body>\n</html>\n","isHtml":false,"htmlPath":"","htmlFiles":[],"prefix":"","pcRepo":"PakePlus","iosRepo":"PakePlus-iOS","androidRepo":"PakePlus-Android","win7Repo":"","versionStr":"web10","more":{"windows":{"label":"bdbabffdffda","title":"生肖抽取","url":"https://localhost","userAgent":"Mozilla/5.0 (Linux; Android 14; Pixel 6) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Mobile Safari/537.36","width":412,"height":915,"theme":null,"resizable":true,"fullscreen":false,"maximized":false,"minWidth":400,"minHeight":300,"maxWidth":1920,"maxHeight":1080,"decorations":true,"transparent":false,"titleBarStyle":"Visible","visible":true,"focus":true,"closable":true,"minimizable":true,"maximizable":true,"alwaysOnTop":false,"alwaysOnBottom":false,"center":false,"shadow":true,"skipTaskbar":false,"tabbingIdentifier":null,"parent":null,"dragDropEnabled":true,"browserExtensionsEnabled":false,"devtools":true,"contentProtected":false,"hiddenTitle":false,"incognito":false,"proxyUrl":null,"useHttpsScheme":false,"zoomHotkeysEnabled":false,"acceptFirstMouse":false,"create":false,"backgroundColor":null,"backgroundThrottling":null,"javascriptDisabled":false}},"phone":{"fullScreen":false,"launchImage":"","screenOn":false,"download":true,"internet":true,"position":false,"direction":"default","callPhone":false,"microphone":false,"camera":false,"backgrou